  "UrStack: OpenAI Chat Completion": {
    "prefix": "ur-openai-chat",
    "body": [
      "response = client.chat.completions.create(",
      "    model=\"gpt-4o\",",
      "    messages=[",
      "        {\"role\": \"system\", \"content\": \"You are a helpful assistant.\"},",
      "        {\"role\": \"user\", \"content\": ${1:\"$TM_SELECTED_TEXT\"}},",
      "    ],",
      "    temperature=0.7,",
      ")",
      "print(response.choices[0].message.content)"
    ],
    "description": "Basic OpenAI chat completion with system + user messages."
  },
  "UrStack: OpenAI Streaming": {
    "prefix": "ur-openai-stream",
    "body": [
      "stream = client.chat.completions.create(",
      "    model=\"gpt-4o\",",
      "    messages=[{\"role\": \"user\", \"content\": ${1:\"$TM_SELECTED_TEXT\"}}],",
      "    stream=True,",
      ")",
      "for chunk in stream:",
      "    delta = chunk.choices[0].delta.content or \"\"",
      "    print(delta, end=\"\", flush=True)",
      "print()"
    ],
    "description": "Streaming chat completion, token by token."
  },
  "UrStack: OpenAI Function Calling": {
    "prefix": "ur-openai-function",
    "body": [
      "tools = [",
      "    {",
      "        \"type\": \"function\",",
      "        \"function\": {",
      "            \"name\": \"get_weather\",",
      "            \"description\": \"Get current weather for a city\",",
      "            \"parameters\": {",
      "                \"type\": \"object\",",
      "                \"properties\": {\"city\": {\"type\": \"string\"}},",
      "                \"required\": [\"city\"],",
      "            },",
      "        },",
      "    }",
      "]",
      "",
      "response = client.chat.completions.create(",
      "    model=\"gpt-4o\",",
      "    messages=[{\"role\": \"user\", \"content\": ${1:\"$TM_SELECTED_TEXT\"}}],",
      "    tools=tools,",
      "    tool_choice=\"auto\",",
      ")",
      "for tc in response.choices[0].message.tool_calls or []:",
      "    print(tc.function.name, tc.function.arguments)"
    ],
    "description": "OpenAI tool/function calling starter."
  },
