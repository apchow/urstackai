  "UrStack: Retry with Exponential Backoff": {
    "prefix": "ur-retry-backoff",
    "body": [
      "import time, random",
      "",
      "def retry(fn, retries=5, base=1.0, cap=60.0):",
      "    for attempt in range(retries):",
      "        try:",
      "            return fn()",
      "        except Exception:",
      "            if attempt == retries - 1:",
      "                raise",
      "            delay = min(cap, base * (2 ** attempt)) + random.uniform(0, 1)",
      "            time.sleep(delay)"
    ],
    "description": "Resilient retry wrapper for 429/5xx provider errors."
  },
  "UrStack: Token Counter (tiktoken)": {
    "prefix": "ur-token-count",
    "body": [
