    "description": "Pre-check token count before sending a request."
  },
  "UrStack: Safe Env Loader": {
    "prefix": "ur-env-safe",
    "body": [
      "import os",
      "from dotenv import load_dotenv",
      "",
      "load_dotenv()",
      "",
      "def require_env(name):",
      "    val = os.environ.get(name)",
      "    if not val:",
      "        raise RuntimeError(f\"Missing required env var: {name}\")",
      "    return val",
      "",
      "OPENAI_API_KEY = require_env(\"OPENAI_API_KEY\")"
    ],
    "description": "Load env safely and fail fast on missing keys."
  },
