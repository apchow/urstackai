  "UrStack: Text Chunking": {
    "prefix": "ur-chunking",
    "body": [
      "def chunk_text(text, size=500, overlap=50):",
      "    chunks, start = [], 0",
      "    while start < len(text):",
      "        end = start + size",
      "        chunks.append(text[start:end])",
      "        start = max(end - overlap, 0)",
      "        if end >= len(text):",
      "            break",
      "    return chunks"
    ],
    "description": "Split long text into overlapping chunks for RAG."
  },
  "UrStack: FastAPI AI Route": {
    "prefix": "ur-ai-route",
    "body": [
      "from fastapi import FastAPI, HTTPException",
      "from pydantic import BaseModel",
      "from openai import OpenAI",
      "import os",
      "",
      "app = FastAPI()",
      "client = OpenAI(api_key=os.environ.get(\"OPENAI_API_KEY\"))",
      "",
      "class Ask(BaseModel):",
      "    prompt: str",
      "",
      "@app.post(\"/api/ask\")",
      "async def ask(req: Ask):",
      "    try:",
      "        r = client.chat.completions.create(",
      "            model=\"gpt-4o\",",
      "            messages=[{\"role\": \"user\", \"content\": req.prompt}],",
      "        )",
      "        return {\"answer\": r.choices[0].message.content}",
      "    except Exception as e:",
      "        raise HTTPException(status_code=500, detail=str(e))"
    ],
    "description": "Server-side FastAPI proxy, keeps your key off the client."
  },
  "UrStack: Cost Guard (Python)": {
    "prefix": "ur-cost-guard",
    "body": [
      "MAX_COST_USD = 2.0",
      "spent = 0.0",
      "",
      "def charge(tokens_in, tokens_out, price_in=0.000005, price_out=0.000015):",
      "    global spent",
      "    cost = tokens_in * price_in + tokens_out * price_out",
      "    if spent + cost > MAX_COST_USD:",
      "        raise RuntimeError(f\"Spend ceiling hit: spent ${spent:.4f} + ${cost:.4f}\")",
      "    spent += cost",
      "    return cost"
    ],
    "description": "Hard per-task LLM spend ceiling."
  },
