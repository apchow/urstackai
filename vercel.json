{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/payu-initiate",
      "destination": "/api/payu-callback"
    },
    {
      "source": "/.netlify/functions/payu-initiate",
      "destination": "/api/payu-callback"
    },
    {
      "source": "/.netlify/functions/:match*",
      "destination": "/api/:match*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}